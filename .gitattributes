# Normalize detected text files and use LF in working copies.
* text=auto eol=lf

# Windows scripts use CRLF; preserve the wrapper whitespace exception.
*.bat text eol=crlf
gradlew.bat whitespace=cr-at-eol

# Preserve upstream license texts byte-for-byte, including their final blank lines.
licenses/upstream/*.txt whitespace=-blank-at-eof

# Binary assets and archives must not undergo text conversion or merging.
*.jar binary
*.png binary
*.ttf binary
*.aqz binary
*.zip binary
*.pdf binary
