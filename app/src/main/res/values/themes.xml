<resources>
    <style name="Theme.Aqaqeer" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">@color/accent_violet_light</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.Base" parent="Theme.SplashScreen">
        <item name="android:windowLightStatusBar">@bool/splash_light_bars</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Aqaqeer</item>
    </style>
    <style name="Theme.Aqaqeer.Starting" parent="Theme.Aqaqeer.Starting.Base" />
    <style name="Theme.Aqaqeer.Starting.Light" parent="Theme.Aqaqeer.Starting">
        <item name="windowSplashScreenBackground">@color/launch_violet</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.Dark" parent="Theme.Aqaqeer.Starting">
        <item name="windowSplashScreenBackground">@color/launch_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.BlueDark" parent="Theme.Aqaqeer.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/launch_blue_dark</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.GreenDark" parent="Theme.Aqaqeer.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/launch_green_dark</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.RoseDark" parent="Theme.Aqaqeer.Starting.Dark">
        <item name="windowSplashScreenBackground">@color/launch_rose_dark</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.Black" parent="Theme.Aqaqeer.Starting">
        <item name="windowSplashScreenBackground">@color/launch_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.RoseLight" parent="Theme.Aqaqeer.Starting">
        <item name="windowSplashScreenBackground">@color/launch_rose</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.BlueLight" parent="Theme.Aqaqeer.Starting.Light">
        <item name="windowSplashScreenBackground">@color/launch_blue</item>
    </style>
    <style name="Theme.Aqaqeer.Starting.GreenLight" parent="Theme.Aqaqeer.Starting.Light">
        <item name="windowSplashScreenBackground">@color/launch_green</item>
    </style>
</resources>
