<!-- The selected gold/teal/navy artwork fits the 192dp system mask at a 190dp bitmap edge.
     The exit keeps that placement while rotating only the internal ring lines. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="17%" android:insetTop="17%"
    android:insetRight="17%" android:insetBottom="17%">
    <bitmap android:src="@drawable/aqaqeer_launcher" android:gravity="fill" />
</inset>
